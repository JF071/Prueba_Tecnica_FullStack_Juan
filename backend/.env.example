# Conexión a MongoDB. Dos opciones:
#  - Atlas (nube):  mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/productos?retryWrites=true&w=majority
#  - Local:         mongodb://localhost:27017/productos
MONGO_URI=mongodb://localhost:27017/productos

# Secreto para firmar los JWT: largo y aleatorio. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=1h

PORT=3000

# Orígenes que pueden llamar a la API desde el navegador, separados por coma.
# Si se omite, solo se permite http://localhost:5173 (nunca "todos").
CORS_ORIGIN=http://localhost:5173
